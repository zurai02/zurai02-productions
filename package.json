{
  "name": "zurai02-productions-api",
  "version": "3.1.0",
  "description": "Zurai02 Productions backend API — Script hub & execution analytics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.js\"",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "logs": "pm2 logs zurai02-api",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop zurai02-api",
    "pm2:restart": "pm2 restart zurai02-api",
    "docker:build": "docker build -t zurai02-api .",
    "docker:run": "docker run -p 3000:3000 --env-file .env zurai02-api"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^7.5.0",
    "node-fetch": "^2.7.0",
    "uuid": "^9.0.0",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.10.0",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "cookie-parser": "^1.4.6",
    "express-slow-down": "^1.6.0",
    "cloudinary": "^1.40.0",
    "multer": "^1.4.5-lts.1",
    "joi": "^17.9.2",
    "crypto-js": "^4.1.1",
    "node-cron": "^3.0.2",
    "redis": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "prettier": "^3.0.2",
    "@types/node": "^20.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "zurai02",
    "scripts",
    "api",
    "roblox",
    "execution"
  ],
  "author": "Zurai02 Productions",
  "license": "MIT",
  "private": false
}
